# Copiar a .env y completar. No subir .env al repositorio.
PORT=4000
# Origen del front (Next.js) autorizado por CORS
CORS_ORIGIN=http://localhost:3000
# Cantidad de proxies delante de la API (0 si nadie). Poner 1 cuando las consultas llegan a traves del
# servidor de Next o de un balanceador, para que el limite de intentos cuente a cada visitante y no al proxy.
# Solo con la API accesible unicamente a traves de ese proxy: si estuviera expuesta, X-Forwarded-For se podria falsear.
TRUST_PROXY=0
# Consultas de seguimiento por cliente cada 15 minutos
TRACKING_LIMIT=60
# Secreto para firmar tokens: minimo 32 caracteres. Generar uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Usuario de demostracion (autenticacion de PoC)
DEMO_USER=daniel
DEMO_PASSWORD=
