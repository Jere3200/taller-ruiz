# Copiar a .env y completar. No subir .env al repositorio.
PORT=4000
# Origen del front (Next.js) autorizado por CORS
CORS_ORIGIN=http://localhost:3000
# Secreto para firmar tokens: minimo 32 caracteres. Generar uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Usuario de demostracion (autenticacion de PoC)
DEMO_USER=daniel
DEMO_PASSWORD=
